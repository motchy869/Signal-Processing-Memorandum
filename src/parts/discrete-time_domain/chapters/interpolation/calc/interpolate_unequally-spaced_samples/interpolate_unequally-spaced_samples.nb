Cell[BoxData[
 RowBox[{
  RowBox[{"x\[LetterSpace]tld", "[", "t_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sinc", "[", 
      RowBox[{"Pi", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"t", "-", 
          RowBox[{"m", "*", "T\[LetterSpace]tld"}]}], ")"}], "/", 
        "T\[LetterSpace]tld"}]}], "]"}], "*", 
     RowBox[{"x\[LetterSpace]tld\[LetterSpace]arr", "[", 
      RowBox[{"[", 
       RowBox[{"1", "+", "m"}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", 
      RowBox[{"M1", "-", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "(Local) In[16]:=",ExpressionUUID->"3e6a182e-4bfa-49c1-ae35-173675387c33"],

